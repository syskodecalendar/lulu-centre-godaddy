PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Production: set NODE_ENV=production and the public HTTPS origin, no trailing slash.
APP_ORIGIN=http://localhost:3000
# Use an absolute path on a persistent disk. Back up the entire directory.
DATA_DIR=./data
# Local development uses SQLite. Production defaults to MySQL and never silently falls back.
# GoDaddy: set STORAGE_DRIVER=mysql, and use the platform-provided database values.
STORAGE_DRIVER=sqlite
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
# GoDaddy persistent media path (relative to the project root):
# UPLOADS_DIR=./public/assets/uploads
UPLOADS_DIR=
# Seed the first account on startup; subsequent password changes are stored in the DB.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set to 1 ONLY when behind one trusted reverse proxy; restrict direct access to Node.
TRUST_PROXY=0
# Mail server settings: use the real account / app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
